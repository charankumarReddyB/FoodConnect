# Backend Environment Configuration for Supabase Online Database
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Supabase PostgreSQL Connection Credentials
# Direct Connection: jdbc:postgresql://db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# Transaction Pooler: jdbc:postgresql://aws-0-<YOUR_REGION>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
